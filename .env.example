# Copy to .env and adjust local paths. Never commit .env or real secrets.

# MediaPipe Face Landmarker model (required at startup).
MEDIAPIPE_FACE_LANDMARKER_MODEL=models/mediapipe/face_landmarker.task

# Registered face embeddings (<student_id>.npy).
FACE_EMBEDDING_DIR=data/face_embeddings

# SQLite attendance database. Schema is initialized at startup.
ATTENDANCE_DB_PATH=data/attendance.db

# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173

# Face similarity threshold (0.0-1.0).
FACE_MATCH_THRESHOLD=0.40

# Seconds a verified liveness session remains valid.
LIVENESS_VALIDITY_SECONDS=30

# Lifetime of opaque bearer tokens issued by /auth/token.
AUTH_TOKEN_TTL_SECONDS=3600

# Maximum accepted image upload size and decoded image limits.
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16777216

# InsightFace model name and cache directory.
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_ROOT=~/.insightface
